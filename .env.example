# AI Extraction Service (packages/ai-extraction) — NVIDIA NIM, OpenAI-compatible.
# Get a free key at https://build.nvidia.com
NVIDIA_API_KEY=

# apps/api (Fastify) — which port it listens on.
PORT=4000

# apps/web — where it fetches the API from (server-side only, no NEXT_PUBLIC_ prefix needed).
API_URL=http://localhost:4000

# apps/web — same API, but reachable from the browser (wallet reverification
# buttons on the Vendors page call this directly, client-side).
NEXT_PUBLIC_API_URL=http://localhost:4000

# apps/api — Neon/Postgres connection string. Required by the API.
DATABASE_URL=

# --- On-chain settlement (apps/api) -----------------------------------------
# Both keys are required to enable on-chain settlement; /health reports the
# status. Never commit real values.
#
# The issuer signs Proof-of-Payable digests. It never submits a transaction.
#   stellar keys secret pakta_issuer
PAKTA_ISSUER_SECRET=
#
# The executor submits and pays for transactions, and must be the gate's
# configured executor (settle requires its authorization). It cannot invent a
# payable — only settle one the issuer signed.
#   stellar keys secret pakta_executor
PAKTA_EXECUTOR_SECRET=
#
# Which deployments/<network>.json to read contract ids from.
PAKTA_NETWORK=testnet
#
# Run the autonomous Settlement Agent every N milliseconds. 0 (default) = off:
# a server should not start paying suppliers just because it booted.
PAKTA_AGENT_INTERVAL_MS=0

# Enable the destructive demo reset button only on a disposable demo database.
# Keep false for real payables; the API also disables it when settlement is live.
PAKTA_DEMO_RESET_ENABLED=false

# --- MCP server (apps/mcp) ---------------------------------------------------
# The MCP server holds no keys; it calls the API.
PAKTA_API_URL=http://localhost:4000
