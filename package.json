{
  "name": "pakta",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --project ai-extraction --project canonical-model --project exception-service --project ingestion --project proof-builder --project proof-hash --project rules-kernel --project settlement --project stellar-sdk-wrapper",
    "test:integration": "node scripts/test-integration.mjs",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "build:fixture": "tsx fixtures/demo-workbook/build-fixture.ts",
    "build:pdf-fixtures": "tsx fixtures/demo-invoices/build-fixtures.ts",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml --workspace",
    "contract:build": "stellar contract build --manifest-path contracts/payable-contract/Cargo.toml",
    "contract:fmt": "cargo fmt --manifest-path contracts/Cargo.toml --all -- --check",
    "testnet:settle": "tsx scripts/testnet-settle.ts"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "tsx": "4.23.15",
    "@types/node": "24.13.6",
    "exceljs": "4.4.0",
    "pdf-lib": "1.17.1"
  }
}
